#!/bin/sh
#
# Open a path in $EDITOR, defaulting to the current directory.
#
# USAGE:
#
#   $ e
#   # => opens the current directory in your editor
#
#   $ e .
#   $ e /usr/local
#   # => opens the specified directory in your editor

# `-z`, not `test "$1" == ""`: /bin/sh is dash on Ubuntu, which rejects `==`
# in `test` and exits 2, which would fall through to the else branch and open
# the editor on an empty path.
if [ -z "$1" ]; then
  exec $EDITOR .
else
  exec $EDITOR "$1"
fi
