[user]
  name = Aniket Pant
  email = me@aniketpant.com

[init]
  defaultBranch = main

[push]
  default = current
  autoSetupRemote = true

[pull]
  rebase = true

[branch]
  autosetupmerge = true
  autosetuprebase = always

[merge]
  summary = true
  conflictstyle = diff3

[rebase]
  autosquash = true
  updateRefs = true

[color]
  ui = true
  pager = true

[core]
  editor = nvim
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol
  excludesfile = ~/.gitignore
  untrackedCache = true
  ignorecase = false
  pager = delta

[commit]
  template = ~/.gitmessage

[alias]
  co = checkout
  ci = commit
  st = status -sb
  br = branch
  df = diff
  dc = diff --cached
  ls = ls-files
  aa = add --all
  amend = commit --amend
  undo = reset --soft HEAD^
  type = cat-file -t
  dump = cat-file -p
  lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset' --abbrev-commit
  l = log --graph --abbrev-commit --date=relative
  ll = log --pretty=oneline --abbrev-commit --max-count=15
  count = shortlog -sn
  stats = shortlog -sn
  co-pr = !sh -c 'git fetch origin pull/$1/head:pr/$1 && git checkout pr/$1' -

[interactive]
  diffFilter = delta --color-only

[delta]
  features = side-by-side line-numbers decorations
  syntax-theme = Monokai Extended

[delta "decorations"]
  commit-decoration-style = bold ul
  file-style = bold ul
  file-decoration-style = none

[github]
  user = aniketpant

[credential]
  helper = cache

[rerere]
  enabled = true
  autoupdate = true

[http]
  sslVerify = true

# Conditionally include work-specific config
# Create ~/.gitconfig-work on work machines with:
#   [user] email = work-email@example.com
#   [credential ...] ...
#   [url "ssh://..."] insteadOf = ...
[includeIf "gitdir:~/work/"]
  path = ~/.gitconfig-work
